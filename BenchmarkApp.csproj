<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Sdk.Web (ne obicni Sdk) da "serve" podnaredba (Faza 4) moze pokrenuti
       ASP.NET Core / Kestrel iz ISTOG konzolnog projekta, bez dupliciranja
       Queries/*-a u zaseban web projekt. Ostale podnaredbe (generate,
       load-*, verify, bench) i dalje rade identicno - Sdk.Web je nadskup
       obicnog Sdk-a, ne mijenja postojece ponasanje. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.Configuration.Binder/.Json vise NE navodimo
         eksplicitno - Sdk.Web ih vec nosi tranzitivno (v. PropertyGroup
         komentar iznad), a eksplicitan navod bi NuGet upozorio da paket
         "nece biti prunan" (NU1510) - a build MORA proci bez upozorenja. -->
    <PackageReference Include="MongoDB.Driver" Version="3.10.0" />
    <PackageReference Include="Neo4j.Driver" Version="6.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- appsettings.json mora završiti pored .exe/.dll datoteke da ga aplikacija
         može pročitati u runtimeu, zato ga kopiramo pri svakom buildu -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
